# Server only. Never prefix these variables with VITE_ or commit server/.env.
DATABASE_URL=postgresql://boardmate_recovery_login:CHANGE_ME@YOUR_DB_HOST:5432/postgres?sslmode=require
FLASK_SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTP_HMAC_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTP_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
RECOVERY_ORIGIN=http://localhost:5173
# False only for local HTTP development. True behind production HTTPS.
COOKIE_SECURE=False
# Set to the exact IP of your reverse proxy only after it strips client-supplied
# forwarding headers. Leave empty for direct local development.
TRUSTED_PROXY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_USE_TLS=True
